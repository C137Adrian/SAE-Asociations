# ==============================================================================
# 📝 VARIABLES DE ENTORNO - SAE ASSOCIATIONS
# ==============================================================================
# Este archivo documenta TODAS las variables de entorno necesarias.
# 
# ⚠️  IMPORTANTE:
# - NUNCA subir el .env real a Git (está en .gitignore)
# - Copiar este archivo: cp .env.example .env
# - Llenar los valores secretos en .env
# - El .env real está ignorado por Git
# ==============================================================================

# ==============================================================================
# 🔧 CONFIGURACION DEL ENTORNO (Flask)
# ==============================================================================
# FLASK_DEBUG: Activa modo debug con hot reload y mejores errores
# Valores: 1 (activado) o 0 (desactivado)
# En producción: SIEMPRE debe ser 0
FLASK_DEBUG=1

# FLASK_ENV: Define el ambiente en el que corre la app
# Valores: development, production, testing
FLASK_ENV=development

# PORT: Puerto donde escucha el servidor Flask
# Valor por defecto: 3001 (si no está definido en app.py)
PORT=3001

# ==============================================================================
# 🗄️  BASE DE DATOS
# ==============================================================================
# DATABASE_URL: Conexión a la base de datos
# 
# Formatos según el motor:
#   SQLite:    sqlite:///database.db
#   SQLite (absoluto): sqlite:////absolute/path/database.db
#   PostgreSQL: postgresql://usuario:contraseña@localhost:5432/nombre_db
#   MySQL:     mysql+pymysql://usuario:contraseña@localhost:3306/nombre_db
#
# En desarrollo local generalmente se usa SQLite para no tener dependencias
# En producción se recomienda PostgreSQL
DATABASE_URL=sqlite:///database.db

# ==============================================================================
# 🔐 SEGURIDAD Y AUTENTICACION
# ==============================================================================
# SECRET_KEY: Clave secreta principal de Flask
# Se usa para:
#   - Firmar cookies de sesión
#   - Firmar datos en sesiones del servidor
#   - Encriptación general de datos sensibles
# 
# En desarrollo: Puede ser cualquier string
# En producción: DEBE ser una cadena aleatoria fuerte (mínimo 32 caracteres)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production

# JWT_SECRET_KEY: Clave secreta específica para firmar tokens JWT
# Se usa para firmar y validar tokens de autenticación
# Si NO se especifica, Flask-JWT usa SECRET_KEY como fallback
# 
# En producción: DEBE ser diferente a SECRET_KEY
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# FLASK_APP_KEY: Clave adicional para el panel administrativo (Flask-Admin)
# Se usa para proteger rutas de administración
FLASK_APP_KEY=your-flask-app-key

# ==============================================================================
# 📧 SENDGRID (Servicio de envío de emails)
# ==============================================================================
# SENDGRID_API_KEY: API key para autenticación con SendGrid
# Obtener en: https://app.sendgrid.com/settings/api_keys
# 
# Qué es: SendGrid es un servicio que permite enviar emails de forma confiable
# Se usa para: Confirmación de email, reset de contraseña, notificaciones
# 
# Pasos para configurar:
#   1. Crear cuenta en https://sendgrid.com/
#   2. Ir a Settings > API Keys > Create API Key
#   3. Copiar la clave y pegarla aquí
SENDGRID_API_KEY=your-sendgrid-api-key

# SENDGRID_SENDER_EMAIL: Email "desde" del cual se envían los correos
# 
# Importante: Este email DEBE estar verificado en SendGrid
# Pasos:
#   1. Ir a Settings > Sender Authentication
#   2. Verificar este email
# 
# Ejemplo: noreply@sae-associations.com
SENDGRID_SENDER_EMAIL=noreply@sae-associations.com

# ==============================================================================
# 💳 STRIPE (Procesamiento de pagos)
# ==============================================================================
# STRIPE_SECRET_KEY: Clave secreta de Stripe (para el backend)
# 
# ⚠️  CRÍTICO: NUNCA exponer esta clave en el frontend o redes
# Obtener en: https://dashboard.stripe.com/apikeys
# 
# Qué es: Stripe es un procesador de pagos que maneja transacciones seguras
# Se usa para: Crear sesiones de checkout, procesar donaciones
# 
# Tipos de claves:
#   - Desarrollo: sk_test_... (comienza con sk_test)
#   - Producción: sk_live_... (comienza con sk_live)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# STRIPE_PUBLIC_KEY: Clave pública de Stripe (segura para el frontend)
# Obtener en: https://dashboard.stripe.com/apikeys
# 
# Se usa en el navegador para:
#   - Crear elementos de checkout
#   - Iniciar sesiones de pago
# 
# Tipos de claves:
#   - Desarrollo: pk_test_... (comienza con pk_test)
#   - Producción: pk_live_... (comienza con pk_live)
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key

# ==============================================================================
# 🖼️  CLOUDINARY (Gestión y almacenamiento de imágenes)
# ==============================================================================
# VITE_CLOUDINARY_CLOUD_NAME: Nombre único de tu cuenta Cloudinary
# 
# Obtener en: https://cloudinary.com/console/
# Este valor está visible en el dashboard principal
# 
# Qué es: Cloudinary es un servicio para almacenar, optimizar y servir imágenes
# Se usa para: Subir fotos de asociaciones, eventos, perfiles de usuarios
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# VITE_CLOUDINARY_UPLOAD_PRESET: Preset unsigned de Cloudinary
# 
# ¿Qué es? Un preset que permite uploads desde el frontend SIN autenticación
# 
# Pasos para crear:
#   1. Ir a Settings > Upload en https://cloudinary.com/console/
#   2. Upload presets > Add upload preset
#   3. Mode: Unsigned (importante)
#   4. Copiar el nombre del preset aquí
# 
# Seguridad: Como es "unsigned", restringir por dominio/carpeta en Cloudinary
VITE_CLOUDINARY_UPLOAD_PRESET=your-cloudinary-upload-preset

# ==============================================================================
# 🌐 FRONTEND - CONFIGURACION DEL API
# ==============================================================================
# VITE_BACKEND_URL: URL completa del servidor backend
# 
# El frontend usa esta variable para hacer peticiones HTTP al API
# Se carga desde import.meta.env.VITE_BACKEND_URL en componentes React
# 
# Ejemplos según el ambiente:
#   Desarrollo local:  http://localhost:3001
#   Desarrollo remoto: http://127.0.0.1:3001
#   Producción:        https://api.sae-associations.com
# 
# Si NO está definida, el frontend intenta usar window.location.origin
VITE_BACKEND_URL=http://localhost:3001

# ==============================================================================
# 📝 NOTAS IMPORTANTES
# ==============================================================================
# 1. SEGURIDAD:
#    - NUNCA subir .env a Git
#    - Cambiar todas las claves en producción
#    - Usar valores aleatorios fuertes (no los del ejemplo)
#
# 2. DESARROLLO LOCAL:
#    - Copiar este archivo a .env
#    - Llenar los valores según tu setup local
#    - Para pruebas rápidas, algunas variables pueden estar vacías
#
# 3. PRODUCCIÓN:
#    - Usar las claves LIVE de Stripe (sk_live_, pk_live_)
#    - Usar URLs seguras (https://)
#    - Verificar que FLASK_DEBUG=0
#    - Usar una base de datos real (PostgreSQL recomendado)
#
# 4. NUEVAS INTEGRACIONES:
#    - Si agregas nuevos servicios (APIs, etc)
#    - Documentar la variable aquí
#    - Actualizar el código para leerla correctamente
# ==============================================================================
